# Copy to frontend/.env.local and fill in your own values.
TRADING_PULSE_API_URL=http://127.0.0.1:3001
# JWT for the SAME tenant as your simulator, signed by backend.
# This is NOT the JWT signing secret. Never prefix with NEXT_PUBLIC_.
TRADING_PULSE_VIEWER_JWT=

# Studio is opt-in and local-development-only. Leave false until Ollama is installed.
TRADING_PULSE_STUDIO_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
