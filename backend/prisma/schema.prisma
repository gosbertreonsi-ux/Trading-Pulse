datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Trade {
  id        String   @id @default(uuid())
  clientId  String   @default("global") // NEW: Isolates client environments
  symbol    String
  price     Decimal  @db.Decimal(18, 4)
  quantity  Decimal  @db.Decimal(18, 4)
  side      String
  timestamp DateTime @default(now())

  @@index([clientId, symbol, timestamp]) // Optimized compound multi-tenant index
}

model OHLCV {
  id        String   @id @default(uuid())
  clientId  String   @default("global") // NEW: Isolates chart panels
  symbol    String
  timestamp DateTime
  open      Decimal  @db.Decimal(18, 4)
  high      Decimal  @db.Decimal(18, 4)
  low       Decimal  @db.Decimal(18, 4)
  close     Decimal  @db.Decimal(18, 4)
  volume    Decimal  @db.Decimal(18, 4)

  @@unique([clientId, symbol, timestamp]) // Ensures data isolation uniqueness
}

/** A one-shot threshold alert, scoped to the signed-in simulator tenant. */
model PriceAlert {
  id            String    @id @default(uuid())
  clientId      String
  symbol        String
  direction     String
  targetPrice   Decimal   @db.Decimal(18, 4)
  status        String    @default("ACTIVE")
  observedPrice Decimal?  @db.Decimal(18, 4)
  createdAt     DateTime  @default(now())
  triggeredAt   DateTime?

  @@index([clientId, status, symbol])
  @@index([clientId, createdAt])
}
