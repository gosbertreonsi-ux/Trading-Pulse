# Copy to backend/.env and replace example values. Never commit actual secrets.
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/trading_pulse
REDIS_URL=redis://127.0.0.1:6379
# Used to sign and verify JWTs; at least 32 random characters.
TRADING_PULSE_API_TOKEN=replace-with-a-long-unique-random-signing-secret
# A JWT generated with the command from the README; expires after 24h.
SIMULATOR_TOKEN=
TRADING_PULSE_API_URL=http://127.0.0.1:3000
